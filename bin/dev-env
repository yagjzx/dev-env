#!/usr/bin/env bash
set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "$SELF_DIR/.." && pwd)"
WORKSPACE_DIR="$(cd "$ROOT_DIR/.." && pwd)"
REPO_MANIFEST="$ROOT_DIR/manifests/repos.tsv"
SERVICE_MANIFEST="$ROOT_DIR/manifests/services.tsv"
CONTAINER_NAME="${DEV_ENV_CONTAINER:-bladeai-dev}"
CONTAINER_USER="${DEV_ENV_CONTAINER_USER:-vscode}"
CONTAINER_WORKSPACE="/workspace"
CONTAINER_ROOT="$CONTAINER_WORKSPACE/dev-env"

is_in_dev_container() {
    [ -f /.dockerenv ] && [ -d "$CONTAINER_ROOT" ]
}

run_dev() {
    if is_in_dev_container; then
        bash -lc "$*"
    else
        docker exec "$CONTAINER_NAME" gosu "$CONTAINER_USER" bash -lc "$*"
    fi
}

repo_manifest_lines() {
    local tier="${1:-all}"
    if [ "$tier" = "all" ]; then
        awk -F '\t' 'NF >= 3 && $1 !~ /^#/' "$REPO_MANIFEST"
    else
        awk -F '\t' -v tier="$tier" 'NF >= 3 && $1 !~ /^#/ && $1 == tier' "$REPO_MANIFEST"
    fi
}

service_manifest_lines() {
    awk -F '\t' 'NF >= 7 && $1 !~ /^#/' "$SERVICE_MANIFEST"
}

ensure_container_running() {
    if is_in_dev_container; then
        return
    fi
    if ! docker inspect "$CONTAINER_NAME" >/dev/null 2>&1; then
        echo "Dev container not found: $CONTAINER_NAME" >&2
        exit 1
    fi
    local state
    state="$(docker inspect -f '{{.State.Status}}' "$CONTAINER_NAME")"
    if [ "$state" != "running" ]; then
        echo "Dev container is not running: $CONTAINER_NAME ($state)" >&2
        exit 1
    fi
}

service_field() {
    local service="$1"
    local field="$2"
    awk -F '\t' -v name="$service" -v idx="$field" 'NF >= 7 && $1 !~ /^#/ && $1 == name { print $idx; exit }' "$SERVICE_MANIFEST"
}

ensure_service_env() {
    local service="$1"
    local repo_dir env_file template source target
    repo_dir="$(service_field "$service" 2)"
    env_file="$(service_field "$service" 3)"
    template="$(service_field "$service" 4)"
    source="$ROOT_DIR/$template"
    target="$WORKSPACE_DIR/$repo_dir/$env_file"

    if [ -f "$target" ]; then
        return
    fi
    cp "$source" "$target"
    echo "Created $target"
}

repo_missing_lines() {
    while IFS=$'\t' read -r tier repo local_dir; do
        [ -d "$WORKSPACE_DIR/$local_dir/.git" ] && continue
        printf '%s\t%s\t%s\n' "$tier" "$repo" "$local_dir"
    done < <(repo_manifest_lines all)
}

cmd_help() {
    cat <<'EOF'
Usage: dev-env <command> [args]

Commands:
  shell                 Open a shell in bladeai-dev
  doctor                Check Docker, manifest coverage, env files, PM2 and health endpoints
  repos list [tier]     List repos from manifests/repos.tsv
  repos sync [tier]     Clone missing repos from the manifest into the workspace
  up <service|all>      Start clawforce, seedforge, or both inside the dev container
  scan [output]         Generate WORKSPACE_SCAN.md from inside the dev container
EOF
}

cmd_shell() {
    if is_in_dev_container; then
        exec bash
    fi
    ensure_container_running
    exec docker exec -it "$CONTAINER_NAME" gosu "$CONTAINER_USER" bash
}

cmd_repos_list() {
    local tier="${1:-all}"
    repo_manifest_lines "$tier"
}

cmd_repos_sync() {
    local tier="${1:-all}"
    ensure_container_running
    while IFS=$'\t' read -r row_tier repo local_dir; do
        if [ -d "$WORKSPACE_DIR/$local_dir/.git" ]; then
            echo "skip $local_dir"
            continue
        fi
        echo "clone $repo -> $local_dir"
        run_dev "cd '$CONTAINER_WORKSPACE' && gh repo clone '$repo' '$local_dir'"
    done < <(repo_manifest_lines "$tier")
}

cmd_up() {
    local target="${1:-all}"
    ensure_container_running

    case "$target" in
        clawforce)
            ensure_service_env clawforce
            run_dev "'$CONTAINER_ROOT'/sync/up-clawforce.sh"
            ;;
        seedforge)
            ensure_service_env seedforge
            run_dev "'$CONTAINER_ROOT'/sync/up-seedforge.sh"
            ;;
        all)
            ensure_service_env clawforce
            ensure_service_env seedforge
            run_dev "'$CONTAINER_ROOT'/sync/up-clawforce.sh"
            run_dev "'$CONTAINER_ROOT'/sync/up-seedforge.sh"
            ;;
        *)
            echo "Unknown service: $target" >&2
            exit 1
            ;;
    esac
}

check_url() {
    local url="$1"
    if curl -fsS "$url" >/dev/null 2>&1 || curl -I -fsS "$url" >/dev/null 2>&1; then
        echo "ok"
    else
        echo "fail"
    fi
}

cmd_doctor() {
    local expected actual missing_count line

    echo "== dev-env doctor =="
    echo "context: $(if is_in_dev_container; then echo container; else echo host; fi)"

    if docker info >/dev/null 2>&1; then
        echo "docker-daemon: ok"
    else
        echo "docker-daemon: fail"
        return 1
    fi

    if is_in_dev_container; then
        echo "dev-container: current ($CONTAINER_NAME)"
    else
        if docker inspect "$CONTAINER_NAME" >/dev/null 2>&1; then
            echo "dev-container: $(docker inspect -f '{{.State.Status}}' "$CONTAINER_NAME")"
        else
            echo "dev-container: missing"
            return 1
        fi
    fi

    if run_dev "docker info --format '{{.ServerVersion}} {{.OperatingSystem}} {{.NCPU}}' >/dev/null" 2>/dev/null; then
        echo "docker-in-dev: ok"
    else
        echo "docker-in-dev: fail"
        return 1
    fi

    if run_dev "gh auth status >/dev/null 2>&1"; then
        echo "github-auth-in-dev: ok"
    else
        echo "github-auth-in-dev: fail"
    fi

    expected="$(repo_manifest_lines all | wc -l | tr -d ' ')"
    actual="$(find "$WORKSPACE_DIR" -mindepth 1 -maxdepth 2 \( -type d -o -type f \) -name .git | wc -l | tr -d ' ')"
    echo "workspace-repos: $actual/$expected"

    missing_count=0
    while IFS= read -r line; do
        [ -n "$line" ] || continue
        missing_count=$((missing_count + 1))
        if [ "$missing_count" -eq 1 ]; then
            echo "missing-repos:"
        fi
        printf '  %s\n' "$line"
    done < <(repo_missing_lines)
    [ "$missing_count" -eq 0 ] && echo "missing-repos: none"

    while IFS=$'\t' read -r service repo_dir env_file template pm2_names health_urls host_ports; do
        if [ -f "$WORKSPACE_DIR/$repo_dir/$env_file" ]; then
            echo "$service-env: present"
        else
            echo "$service-env: missing"
        fi

        IFS='|' read -r -a urls <<< "$health_urls"
        for url in "${urls[@]}"; do
            echo "$service-health[$url]: $(check_url "$url")"
        done
    done < <(service_manifest_lines)

    echo "pm2:"
    run_dev "pm2 list"
}

cmd_scan() {
    local output="${1:-$CONTAINER_WORKSPACE/WORKSPACE_SCAN.md}"
    ensure_container_running
    run_dev "python3 '$CONTAINER_ROOT/sync/workspace-scan.py' --workspace '$CONTAINER_WORKSPACE' --output '$output'"
}

subcommand="${1:-help}"
shift || true

case "$subcommand" in
    help|-h|--help)
        cmd_help
        ;;
    shell)
        cmd_shell "$@"
        ;;
    doctor)
        cmd_doctor "$@"
        ;;
    repos)
        action="${1:-list}"
        shift || true
        case "$action" in
            list) cmd_repos_list "$@" ;;
            sync) cmd_repos_sync "$@" ;;
            *) echo "Unknown repos action: $action" >&2; exit 1 ;;
        esac
        ;;
    up)
        cmd_up "$@"
        ;;
    scan)
        cmd_scan "$@"
        ;;
    *)
        echo "Unknown command: $subcommand" >&2
        cmd_help >&2
        exit 1
        ;;
esac
